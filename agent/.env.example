MOCK_MODE=true
ALLOWED_SERVICES=icecast,liquidsoap_1,liquidsoap_2
AGENT_SHARED_TOKEN=dev-agent-token

# Per-radio Liquidsoap routing (radio_id:host:telnet_port:ingest_port)
# Must match the liquidsoap_N services in docker-compose.yml
RADIO_LIQUIDSOAP_MAP=1:liquidsoap_1:1234:8001,2:liquidsoap_2:1234:8002
