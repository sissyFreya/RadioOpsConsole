# ===== Backend =====
POSTGRES_USER=radioops
POSTGRES_PASSWORD=radioops
POSTGRES_DB=radioops
POSTGRES_HOST=db
POSTGRES_PORT=5432

JWT_SECRET=change-me-super-secret
JWT_ACCESS_MINUTES=60

BOOTSTRAP_ADMIN_EMAIL=admin@local
BOOTSTRAP_ADMIN_PASSWORD=admin

# ===== Agent (docker-compose demo agent) =====
AGENT_URL=http://agent:9000
AGENT_SHARED_TOKEN=dev-agent-token

# ===== Icecast public URL (used by the frontend to build stream links) =====
# In production, set this to your server's public IP or domain, e.g.:
# ICECAST_PUBLIC_BASE=http://149.202.41.3:8000
ICECAST_PUBLIC_BASE=http://localhost:8000

# ===== Icecast credentials (change all in production!) =====
ICECAST_SOURCE_PASSWORD=sourcepass
ICECAST_RELAY_PASSWORD=relaypass
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=adminpass

# ===== Liquidsoap mount names — must match the radio's slug in the DB =====
# Run: SELECT id, name, mounts FROM radios;  to find the right values.
# Default fallback is /radio_1, /radio_2 — override here if your DB has slug-based mounts.
# RADIO_1_MOUNT=/demo-radio
# RADIO_2_MOUNT=/test

# ===== Frontend =====
# Empty in Docker Compose: the frontend nginx proxies API requests to backend.
# For a separately served frontend, set this to the backend URL, e.g. http://localhost:8081
VITE_API_BASE=

# Agent browser-mic WebSocket. Leave empty unless you intentionally expose the agent.
VITE_AGENT_WS_BASE=
